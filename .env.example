# Copy to .env and fill in. Never commit .env. Keys stay on the server; browsers never see them.
# Full reference and licensing notes: docs/DATA_SOURCES.md

# --- access & licensing ---
ACCESS_MODE=personal             # personal (your own use) | public (anonymous visitors; see docs/DATA_SOURCES.md §2)
PUBLIC_DISPLAY_LICENSES=         # public mode only: providers you may display publicly, e.g. massive,fmp,cboe

# --- live prices + history (configure at least one) ---
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_FEED=iex                  # iex (free real-time, one venue) | sip (paid real-time) | delayed_sip (15-min delayed)

MASSIVE_API_KEY=                 # Massive (formerly Polygon.io)
MASSIVE_REALTIME=false           # true if your plan includes real-time stocks
MASSIVE_INDICES=false            # true if your plan includes Indices (live VIX)
MASSIVE_OPTIONS=false            # true if your plan includes Options (chain snapshots)

TIINGO_API_KEY=                  # long dividend-adjusted daily history

# --- reference, fundamentals, breadth membership ---
FMP_API_KEY=                     # Financial Modeling Prep

# --- macro ---
FRED_API_KEY=                    # optional: first-release (point-in-time) vintages. https://fred.stlouisfed.org/docs/api/api_key.html

# --- AI analyst (optional) ---
ANTHROPIC_API_KEY=
ANALYST_MODEL=claude-opus-5-5

# --- product ---
BENCHMARKS=SPY,QQQ
STREAM_PROVIDERS=alpaca,massive
HISTORY_PROVIDERS=massive,tiingo,alpaca
BREADTH_ENABLED=true

# --- limits & tuning ---
MAX_SYMBOLS_PER_CLIENT=12
RATE_LIMIT_PER_MIN=120
HEAVY_RATE_LIMIT_PER_MIN=6
ANALYST_PER_HOUR=10
COMMISSION_BPS=1.0
SLIPPAGE_BPS=2.0

# --- docker compose ---
API_PORT=127.0.0.1:8000
