# Copy to .env and fill in. Never commit .env.

# --- required for any internet-facing deployment ---
APP_ACCESS_TOKEN=            # long random string; devices sign in with it (python -c "import secrets;print(secrets.token_urlsafe(32))")
POSTGRES_PASSWORD=           # docker-compose database password
COOKIE_SECURE=true           # set false only for plain-http local testing

# --- data providers (all optional; free tiers) ---
FRED_API_KEY=                # enables ALFRED first-release vintages (true point-in-time macro). https://fred.stlouisfed.org/docs/api/api_key.html
TIINGO_API_KEY=              # official EOD prices; Yahoo chart API is the keyless fallback
SP500_HISTORY_URL=           # optional CSV of historical S&P 500 membership (date,tickers) to remove breadth survivorship bias
BENCHMARKS=SPY,QQQ

# --- AI analyst (optional) ---
ANTHROPIC_API_KEY=
ANALYST_MODEL=claude-opus-5-5

# --- Web Push (optional): generate with `python -m app.cli vapid` ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- tuning ---
COMMISSION_BPS=1.0
SLIPPAGE_BPS=2.0
MAX_ALERTS_PER_DAY=10
STALE_AFTER_DAYS=4
